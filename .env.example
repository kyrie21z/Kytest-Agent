# ============================================================
# Code Agent 配置文件示例
# 使用方法：复制本文件为 .env，填入 API Key（.env 不会被提交到 Git）
# ============================================================

# ---------- 当前选定的模型：阿里云百炼 qwen3.7-flash ----------
#
# 已核实（2026-10，来源：https://help.aliyun.com/zh/model-studio/qwen3-7-flash）：
#   支持 Function Calling、上下文 100 万 token、最大输出 131072 token
#   北京地域价格：输入 0.2 元 / 百万 token，输出 0.8 元 / 百万 token（输入 ≤32k）
#
# BASE_URL 有两种写法：
#   推荐（性能与稳定性更好）：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   兼容（旧域名，仍可用）：  https://dashscope.aliyuncs.com/compatible-mode/v1
#   {WorkspaceId} 在百炼控制台的「业务空间详情」页面查看。
#   注意：API Key 按地域绑定，北京地域的 Key 不能用于其它地域的 endpoint。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash

# 换成你自己的百炼 API Key（形如 sk-xxxxxxxx）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 其它可选的服务商（二选一，取消注释即可切换）----------
# DeepSeek：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# OpenAI：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------- LLM 可选参数 ----------
# 注意：百炼文档明确不建议把 temperature 设为 0（"无意义"），取 0.2 即可。
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---------- Agent 行为 ----------
AGENT_MAX_STEPS=8
AGENT_MAX_CONTEXT_CHARS=32000

# ---------- 工作区与安全 ----------
# 留空则默认为启动命令所在目录；文件工具限制在该目录内
# sandbox 命令仅挂载工作区和只读运行库；trusted 具有宿主机权限
# CODE_AGENT_WORKSPACE=D:\my-project
ALLOW_CODE_EXECUTION=true
# 默认 Linux Bubblewrap 隔离；不可用时拒绝执行，不自动回落
# trusted 仅适用于受信本机代码，disabled 禁止执行
EXECUTION_MODE=sandbox
# sandbox 中工作区写权限；false 时 trusted 命令也被拒绝
ALLOW_WRITE=true
EXEC_TIMEOUT=10
MAX_EXEC_TIMEOUT=300
MAX_FILE_BYTES=200000
