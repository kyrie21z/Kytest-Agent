LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
AGENT_MAX_STEPS=12
AGENT_MAX_CONTEXT_CHARS=32000
